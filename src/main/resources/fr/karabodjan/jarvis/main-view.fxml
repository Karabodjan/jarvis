<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.karabodjan.jarvis.view.MainController"
            prefWidth="1000" prefHeight="650"
            styleClass="jarvis-root"
            stylesheets="@style.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="jarvis-toolbar">

            <!-- Logo (left) -->
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="J.A.R.V.I.S." styleClass="jarvis-logo"/>
                <Label text="Control Tower" styleClass="jarvis-logo-sub"/>
            </VBox>

            <!-- Spacer: pushes controls to the right -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Controls (right) -->
            <Label text="AUTO-MERGE" styleClass="jarvis-field-label"/>
            <Button fx:id="autoMergeToggle" text="OFF"
                    onAction="#onAutoMergeToggled"
                    styleClass="toggle-off"/>

            <Button fx:id="historyButton" text="📜 History"
                    onAction="#onHistoryClicked"
                    styleClass="history-button"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="0" styleClass="jarvis-sidebar" prefWidth="240">
            <padding>
                <Insets top="14" right="8" bottom="14" left="8"/>
            </padding>
            <Label text="AGENTS" styleClass="jarvis-sidebar-title">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
            </Label>
            <ListView fx:id="agentListView" styleClass="agent-list" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" alignment="TOP_LEFT" styleClass="jarvis-main">
            <padding>
                <Insets top="28" right="30" bottom="28" left="30"/>
            </padding>

            <Label fx:id="detailTitleLabel" text="Select an agent"
                   styleClass="jarvis-agent-title"/>

            <Label fx:id="detailPlaceholderLabel"
                   text="Pick an agent from the sidebar to see details."
                   styleClass="jarvis-placeholder"/>

            <VBox fx:id="detailFieldsBox" spacing="5" visible="false" managed="false">

                <Label text="REPOSITORY" styleClass="jarvis-field-label"/>
                <Label fx:id="detailRepoLabel" text="" styleClass="jarvis-field-value"/>

                <Label text="TASK TYPE" styleClass="jarvis-field-label">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
                <Label fx:id="detailTaskTypeLabel" text="" styleClass="jarvis-field-value"/>

                <Label text="STATUS" styleClass="jarvis-field-label">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
                <Label fx:id="detailStatusLabel" text="" styleClass="status-label"/>

                <Label text="CREATED AT" styleClass="jarvis-field-label">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
                <Label fx:id="detailCreatedAtLabel" text="" styleClass="jarvis-field-value"/>

                <Label text="MESSAGE" styleClass="jarvis-field-label">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
                <Label fx:id="detailMessageLabel" text="" wrapText="true"
                       styleClass="jarvis-field-value"/>

                <Label text="PROGRESS" styleClass="jarvis-field-label">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
                <ProgressBar fx:id="detailProgressBar" progress="0.0"
                             maxWidth="Infinity"/>

                <HBox spacing="10">
                    <VBox.margin><Insets top="18"/></VBox.margin>
                    <Button fx:id="launchButton" text="▶  Launch Agent"
                            onAction="#onLaunchClicked"
                            styleClass="launch-button"/>
                    <Button fx:id="cancelButton" text="✕  Cancel"
                            onAction="#onCancelClicked"
                            visible="false" managed="false"
                            styleClass="cancel-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <VBox styleClass="log-console" prefHeight="170">
            <padding>
                <Insets top="8" right="12" bottom="10" left="12"/>
            </padding>
            <Label text="CONSOLE" styleClass="log-title"/>
            <ListView fx:id="logListView" styleClass="log-list" VBox.vgrow="ALWAYS"/>
        </VBox>
    </bottom>

</BorderPane>
